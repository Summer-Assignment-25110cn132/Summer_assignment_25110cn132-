def largest_prime_factor(n):
    largest = 1

    # Remove factors of 2
    while n % 2 == 0:
        largest = 2
        n //= 2

    # Check odd factors
    factor = 3
    while factor * factor <= n:
        while n % factor == 0:
            largest = factor
            n //= factor
        factor += 2

    # If n is still greater than 2, it is prime
    if n > 2:
        largest = n

    return largest

# Input from user
num = int(input("Enter a number: "))
print("Largest prime factor:", largest_prime_factor(num))